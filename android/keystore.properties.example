# Copy to android/keystore.properties (git-ignored, NEVER commit it) to sign release builds
# with your private UPLOAD key. See GOOGLE_PLAY_RELEASE.md, "Create and back up the upload key".
# Paths are relative to the android/ folder; an absolute path outside the project is safest.
storeFile=C:/Users/YOU/keys/neon-escape-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
